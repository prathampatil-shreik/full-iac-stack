{
  "format_version": "1.2",
  "resource_changes": [
    {
      "address": "module.database.aws_db_instance.this",
      "type": "aws_db_instance",
      "change": {
        "actions": ["create"],
        "after": {
          "identifier": "iac-platform-dev-db",
          "instance_class": "db.t3.micro",
          "storage_encrypted": true,
          "publicly_accessible": false,
          "tags": {
            "Project": "iac-platform",
            "Environment": "dev",
            "ManagedBy": "Terraform"
          }
        },
        "after_unknown": {}
      }
    },
    {
      "address": "module.storage.aws_s3_bucket.this",
      "type": "aws_s3_bucket",
      "change": {
        "actions": ["create"],
        "after": {
          "bucket": "iac-platform-dev-assets",
          "tags": {
            "Project": "iac-platform",
            "Environment": "dev",
            "ManagedBy": "Terraform"
          }
        },
        "after_unknown": { "id": true }
      }
    },
    {
      "address": "module.storage.aws_s3_bucket_public_access_block.this",
      "type": "aws_s3_bucket_public_access_block",
      "change": {
        "actions": ["create"],
        "after": {
          "block_public_acls": true,
          "block_public_policy": true,
          "ignore_public_acls": true,
          "restrict_public_buckets": true
        },
        "after_unknown": {}
      }
    },
    {
      "address": "module.storage.aws_s3_bucket_server_side_encryption_configuration.this",
      "type": "aws_s3_bucket_server_side_encryption_configuration",
      "change": {
        "actions": ["create"],
        "after": {
          "bucket": "iac-platform-dev-assets",
          "rule": [
            {
              "apply_server_side_encryption_by_default": [
                { "sse_algorithm": "AES256" }
              ]
            }
          ]
        },
        "after_unknown": {}
      }
    },
    {
      "address": "module.compute.aws_security_group_rule.alb_ingress_http",
      "type": "aws_security_group_rule",
      "change": {
        "actions": ["create"],
        "after": {
          "type": "ingress",
          "from_port": 80,
          "to_port": 80,
          "protocol": "tcp",
          "cidr_blocks": ["0.0.0.0/0"],
          "ipv6_cidr_blocks": [],
          "description": "Allow HTTP from internet"
        },
        "after_unknown": {}
      }
    },
    {
      "address": "module.compute.aws_security_group_rule.ecs_ingress_from_alb",
      "type": "aws_security_group_rule",
      "change": {
        "actions": ["create"],
        "after": {
          "type": "ingress",
          "from_port": 80,
          "to_port": 80,
          "protocol": "tcp",
          "cidr_blocks": [],
          "ipv6_cidr_blocks": [],
          "source_security_group_id": "sg-alb",
          "description": "Allow container port traffic from ALB"
        },
        "after_unknown": {}
      }
    },
    {
      "address": "module.vpc.aws_vpc.this",
      "type": "aws_vpc",
      "change": {
        "actions": ["create"],
        "after": {
          "cidr_block": "10.0.0.0/16",
          "tags": {
            "Project": "iac-platform",
            "Environment": "dev",
            "ManagedBy": "Terraform"
          }
        },
        "after_unknown": {}
      }
    }
  ]
}

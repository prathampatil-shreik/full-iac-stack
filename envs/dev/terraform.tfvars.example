aws_region   = "us-east-1"
project_name = "iac-platform"
environment  = "dev"

# ── VPC ───────────────────────────────────────────────────────────────────────
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]
enable_nat_gateway   = true
nat_gateway_mode     = "single"

# ── Compute ───────────────────────────────────────────────────────────────────
container_image    = "nginx:alpine"
container_port     = 80
task_cpu           = 256
task_memory        = 512
desired_count      = 1
health_check_path  = "/"
log_retention_days = 7

# ── Database ──────────────────────────────────────────────────────────────────
db_name     = "appdb"
db_username = "dbadmin"

# DO NOT set db_password here.
# Supply it via environment variable before running terraform plan or apply:
#   $env:TF_VAR_db_password = "YourDevPassword123!"

db_instance_class          = "db.t3.micro"
db_allocated_storage       = 20
db_max_allocated_storage   = 50
db_backup_retention_period = 3
db_multi_az                = false
db_deletion_protection     = false
db_skip_final_snapshot     = true

# ── Storage ───────────────────────────────────────────────────────────────────
# Must be globally unique across all AWS S3 buckets.
# Final bucket name: iac-platform-dev-<bucket_suffix>
bucket_suffix      = "replace-with-unique-suffix"
versioning_enabled = true

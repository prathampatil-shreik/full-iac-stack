aws_region   = "us-east-1"
project_name = "iac-platform"
environment  = "prod"

# ── VPC ───────────────────────────────────────────────────────────────────────
# Prod uses a separate CIDR range from dev to allow future VPC peering
vpc_cidr             = "10.1.0.0/16"
public_subnet_cidrs  = ["10.1.1.0/24", "10.1.2.0/24"]
private_subnet_cidrs = ["10.1.11.0/24", "10.1.12.0/24"]
enable_nat_gateway   = true
nat_gateway_mode     = "per_az"

# ── Compute ───────────────────────────────────────────────────────────────────
container_image    = "nginx:alpine"
container_port     = 80
task_cpu           = 512
task_memory        = 1024
desired_count      = 2
health_check_path  = "/"
log_retention_days = 30

# ── Database ──────────────────────────────────────────────────────────────────
db_name     = "appdb"
db_username = "dbadmin"

# DO NOT set db_password here.
# Supply it via environment variable before running terraform plan or apply:
#   $env:TF_VAR_db_password = "YourProdPassword123!"
# In production, retrieve the password from AWS Secrets Manager.

db_instance_class          = "db.t3.small"
db_allocated_storage       = 50
db_max_allocated_storage   = 200
db_backup_retention_period = 14
db_multi_az                = true
db_deletion_protection     = true
db_skip_final_snapshot     = false

# ── Storage ───────────────────────────────────────────────────────────────────
# Must be globally unique across all AWS S3 buckets.
# Final bucket name: iac-platform-prod-<bucket_suffix>
bucket_suffix      = "replace-with-unique-suffix"
versioning_enabled = true

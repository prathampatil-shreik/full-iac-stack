project_name = "iac-platform"
environment  = "dev"

# Replace with real IDs from your VPC and Compute module outputs
vpc_id                    = "vpc-0123456789abcdef0"
private_subnet_ids        = ["subnet-0123456789abcdef2", "subnet-0123456789abcdef3"]
allowed_security_group_id = "sg-0123456789abcdef0"

db_name     = "appdb"
db_username = "dbadmin"

# DO NOT set db_password here.
# Supply it securely using the environment variable:
#   PowerShell: $env:TF_VAR_db_password = "YourSecurePassword123!"
#   Bash:       export TF_VAR_db_password="YourSecurePassword123!"

instance_class          = "db.t3.micro"
allocated_storage       = 20
max_allocated_storage   = 100
backup_retention_period = 7

# Set to false for production — enables Multi-AZ (doubles cost)
multi_az = false

# Set to true for production to prevent accidental deletion
deletion_protection = false

# Set to false for production to retain a final snapshot on destroy
skip_final_snapshot = true

tags = {
  Project     = "iac-platform"
  Environment = "dev"
  ManagedBy   = "Terraform"
}
